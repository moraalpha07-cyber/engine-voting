# ==========================================
# 🔹 Firebase Configuration
# ==========================================
FIREBASE_DATABASE_URL=https://projectallow-default-rtdb.firebaseio.com/

# Option A: Paste the entire content of your service-account.json below
FIREBASE_SERVICE_ACCOUNT={"type": "service_account", "project_id": "...", "private_key": "...", ...}

# Option B: OR simply place your 'service-account.json' in this folder and you can leave FIREBASE_SERVICE_ACCOUNT blank.

# ==========================================
# 🔹 Grafana Configuration
# ==========================================
GRAFANA_URL=https://monitor.trax-cloud.com/api/datasources/proxy/29/render
# Get your session cookie from browser inspect -> Application -> Cookies -> grafana_session
GRAFANA_SESSION_ID=your_grafana_session_cookie_here

# ==========================================
# 🔹 Telegram Configuration
# ==========================================
TELEGRAM_BOT_TOKEN=1623834999:AAH9kS6Y_R150sI98Qyk7v7SN5MgKhSq1kA
# 1. Masking Drop Alerts Group:
TELEGRAM_CHAT_ID=@NestPT
TELEGRAM_CHAT_ID_DROPS=@NestPT

# 2. Inflow Alerts Group:
TELEGRAM_CHAT_ID_INFLOW=-1004486777652

# ==========================================
# 🔹 Optional Settings
